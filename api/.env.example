# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it's already in .gitignore.
# The mock backend needs NONE of these; they're only for live ADO + AI.

# --- Azure DevOps (live PR data) ---
ADO_ORG=your-org
ADO_PROJECT=your-project
# Dev-only Personal Access Token (Code: Read & Write, Pull Request: Read & Write).
# Production uses the signed-in user's Entra token instead.
ADO_PAT=

# --- Azure OpenAI (AI summary / risk / comments) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- server ---
PORT=3000
